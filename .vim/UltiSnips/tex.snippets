endsnippet

context "math()"
snippet '(f)([a-np-zA-Z0-9])' "function auto include parameter" wrA
`!p
snip.rv = match.group(1)`(`!p snip.rv=match.group(2)`)
endsnippet


context "math()"
snippet compl "complement" iA
^{c}
endsnippet

context "math()"
snippet \\\ "setminus" iA
\setminus 
endsnippet

context "math()"
snippet norm "norm" iA
\|$1\|$0
endsnippet

context "math()"
snippet sminus "setminus" Ai
\implies
endsnippet

context "math()"
snippet ceil "ceil" iA
\left\lceil $1 \right\rceil $0
